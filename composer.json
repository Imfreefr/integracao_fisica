{
    "name": "lab/agua-qualidade",
    "description": "Laboratório digital de testes de qualidade da água - ODS 6",
    "type": "project",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {"App\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Tests\\": "tests/"}
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "coverage": "phpunit --coverage-text"
    }
}
